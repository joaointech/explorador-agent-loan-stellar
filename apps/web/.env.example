# Environment for the web app AND the scripts: both read apps/web/.env.local.
# `pnpm keys:generate` creates apps/web/.env.local from this template and fills in the role keys
# (funded with Friendbot), the attester key and the secrets; or copy this file by hand.
# Never commit .env.local. Stellar testnet keys only: never reuse them anywhere else.
# On Vercel set the same variables in the project settings (README, "Deploying to Vercel + Neon").

# ---- App ----
DATABASE_URL=postgresql://advance:advance@localhost:5433/advance  # docker compose Postgres; Neon pooled URL on Vercel
APP_URL=http://localhost:3000   # public base URL: WebAuthn origin, ASA endpoint, cpcv_note token_uri base (fixed at deploy)
SESSION_SECRET=                 # ≥ 32 random chars
ADMIN_EMAILS=you@explorador.ai  # comma-separated; these emails get the ADMIN role
BREVO_API_KEY=                  # Brevo transactional email (same account as explorador.pt); preferred when set
BREVO_SENDER_EMAIL=             # a sender on a Brevo-authenticated domain, e.g. joaointech@explorador.pt
BREVO_SENDER_NAME="explorador advance"
BREVO_SANDBOX=                  # "true": Brevo validates but drops every email (testing)
RESEND_API_KEY=                 # optional in dev: codes are logged to the server console
# Sender of the sign-in codes (its domain must be verified in Resend):
EMAIL_FROM="explorador advance <advance@explorador.ai>"
WEBAUTHN_RP_ID=localhost        # advance.explorador.ai in production
# Name shown in the passkey prompt:
WEBAUTHN_RP_NAME="explorador advance"

# ---- Stellar (testnet only) ----
STELLAR_NETWORK=testnet         # the only supported value
STELLAR_RPC_URL=https://soroban-testnet.stellar.org  # Soroban RPC for the server and (via /api/config) investors' browsers
# Network passphrase, must match the RPC:
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ADMIN_SECRET=                   # S…: contract admin (deploys, wiring, demo clock); pays wasm uploads and deploys
OPERATOR_SECRET=                # S…: mints notes, card draws, settle, cancel, write-off; pays most app transactions
TREASURY_SECRET=                # S…: pays commissions at settlement, owns the junior tranche, receives protocol fees
CARD_SETTLEMENT_PUBLIC=         # G…: receives the tEURC of every card spend (only the public key is stored)
SPONSOR_SECRET=                 # S…: deploys agent smart accounts; source and fee payer of agent (passkey) transactions
DEMO_SIGNER_SEED=               # 32 bytes, hex: derives the seed agents' Ed25519 demo signers (falls back to SPONSOR_SECRET)
# Optional overrides; default to the smart-account-kit testnet deployment (OpenZeppelin smart account):
SMART_ACCOUNT_WASM_HASH=        # 1b5f4534a76322da2ad7c745f6900857a6802b0ca79850c35a03561df997785a
WEBAUTHN_VERIFIER_ID=           # CC7EKIHQP3TN4CARQDND6CEOY2UXLWWC2X5GHTD5NLAT7BG5GPZIOM3F
ED25519_VERIFIER_ID=            # CAAVTMCBXEIBPR64EAASKFXERVPYFZA2JYP5A3BG6PESWEFUJX5IHKN4
DEMO_MODE=true                  # demo clock, Reset demo, on-screen codes for seeded agents; unset = true, other values = off
# Opt-in, off by default: with DEMO_MODE, show the sign-in code of a seeded @demo.explorador.pt admin
# (e.g. admin@demo.explorador.pt in ADMIN_EMAILS) on the sign-in page. ANYONE can then become admin:
# never set it on a public deployment. Without it that admin's code is only printed in the server console.
DEMO_ADMIN_SIGNIN=

# ---- ZK attestation (off-chain secrets) ----
ATTESTER_EDDSA_PRIVKEY=         # BabyJubJub private key (hex), off-chain only
NULLIFIER_SECRET=               # BN254 field element (decimal)
PII_ENCRYPTION_KEY=             # 32 bytes, hex (AES-256-GCM)
# Optional: directory holding cpcv_attestation.wasm, cpcv_attestation_final.zkey and verification_key.json (default apps/web/zk):
# ZK_ARTIFACTS_DIR=

# ---- Card (Lithic sandbox) and cron ----
LITHIC_API_KEY=                 # sandbox key; unset → in-app simulated card network
LITHIC_ASA_HMAC_SECRET=         # filled by `pnpm lithic:enroll`
CRON_SECRET=                    # optional: bearer token Vercel Cron sends to /api/cron/retry-draws (/api/cron/sync is public; admins can call both)

# ---- Signed CPCV upload: AI prefill (optional) ----
# Claude API key (console.anthropic.com). When set, the signed CPCV PDF uploaded on Admin → New CPCV is sent to
# the Anthropic API (claude-opus-5-5) to pre-fill the form; the admin reviews every field. The PDF is personal data:
# a production deployment needs the appropriate data-processing terms with Anthropic. Unset = the PDF is still stored
# (encrypted) with the deal and the admin fills the form by hand.
ANTHROPIC_API_KEY=

# ---- Tests (optional) ----
# DB-backed Vitest files run only when this is set: a separate database, schema created with `prisma db push`:
# TEST_DATABASE_URL=postgresql://advance:advance@localhost:5433/advance_test
# Read from the shell only, not from this file:
#   E2E_DATABASE_URL=postgresql://advance:advance@localhost:5433/advance_e2e   (pnpm e2e's own database; this is the default)
#   INVEST_E2E_APP_URL=http://localhost:3000   (opt-in investor flow on testnet: lib/wallet/testnet.e2e.test.ts)
