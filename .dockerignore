# Build context for deploy/Dockerfile (context = repo root). The Dockerfile
# copies only what it names; this keeps the context small and keeps local
# state out of it.

# VCS, CI, editors, agents
.git
.github
.claude
.vscode
.idea
**/.DS_Store

# Secrets: never in an image or a build context (the template may stay)
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# Dependencies and build output: rebuilt inside the image
node_modules
**/node_modules
.pnpm-store
**/.next
**/out
**/build
**/coverage
**/*.tsbuildinfo
**/next-env.d.ts
# generated Prisma client: `prisma generate` runs in the image
apps/web/lib/generated

# Rust, Soroban and circuit build products
target
**/target
.stellar
circuits/build
*.ptau

# Deploy tooling state
.vercel
**/.vercel
*.log
