# Copy to apps/web/.env.local (`pnpm keys:generate` writes most of these for you).

DATABASE_URL=postgresql://advance:advance@localhost:5433/advance
APP_URL=http://localhost:3000
SESSION_SECRET=                 # ≥ 32 random chars
ADMIN_EMAILS=you@explorador.ai  # comma-separated; these emails get the ADMIN role
RESEND_API_KEY=                 # optional in dev: codes are logged to the server console
EMAIL_FROM="explorador advance <advance@explorador.ai>"
WEBAUTHN_RP_ID=localhost        # advance.explorador.ai in production
WEBAUTHN_RP_NAME="explorador advance"

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ADMIN_SECRET=
OPERATOR_SECRET=
TREASURY_SECRET=
CARD_SETTLEMENT_PUBLIC=
SPONSOR_SECRET=
DEMO_SIGNER_SEED=               # 32 bytes, hex: derives the seed agents' Ed25519 demo signers (falls back to SPONSOR_SECRET)
# Optional overrides; default to the smart-account-kit testnet deployment (OpenZeppelin smart account):
SMART_ACCOUNT_WASM_HASH=        # 1b5f4534a76322da2ad7c745f6900857a6802b0ca79850c35a03561df997785a
WEBAUTHN_VERIFIER_ID=           # CC7EKIHQP3TN4CARQDND6CEOY2UXLWWC2X5GHTD5NLAT7BG5GPZIOM3F
ED25519_VERIFIER_ID=            # CAAVTMCBXEIBPR64EAASKFXERVPYFZA2JYP5A3BG6PESWEFUJX5IHKN4
DEMO_MODE=true
# Opt-in, off by default: with DEMO_MODE, show the sign-in code of a seeded @demo.explorador.pt admin
# (e.g. admin@demo.explorador.pt in ADMIN_EMAILS) on the sign-in page. ANYONE can then become admin:
# never set it on a public deployment. Without it that admin's code is only printed in the server console.
DEMO_ADMIN_SIGNIN=

ATTESTER_EDDSA_PRIVKEY=         # BabyJubJub private key (hex), off-chain only
NULLIFIER_SECRET=               # BN254 field element (decimal)
PII_ENCRYPTION_KEY=             # 32 bytes, hex (AES-256-GCM)

LITHIC_API_KEY=                 # sandbox key; unset → in-app simulated card network
LITHIC_ASA_HMAC_SECRET=         # filled by `pnpm lithic:enroll`
CRON_SECRET=                    # optional: bearer token for /api/cron/* (admins can always call them)

# pnpm e2e runs against its own database (created + migrated on the fly), never the demo one:
# E2E_DATABASE_URL=postgresql://advance:advance@localhost:5433/advance_e2e
