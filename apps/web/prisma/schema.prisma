// Data model from spec §9.1. Live balances/debt/credit are read from the
// contracts; Postgres holds history (indexed events), auth, cards and the
// encrypted CPCV PII.
//
// Prisma 7: the datasource URL lives in prisma.config.ts (not here), the
// client is generated into lib/generated/prisma, and lib/db connects through
// the @prisma/adapter-pg driver adapter (local Postgres and Neon alike).
// Schema changes must be additive: other workstreams build against it.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AGENT
  ADMIN
}

enum CpcvStatus {
  DRAFT
  PROVING
  MINTED
  SETTLED
  CANCELLED
  WRITTEN_OFF
  FAILED
}

enum AuthDecision {
  APPROVED
  DECLINED
}

enum ChainStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  role          Role
  displayName   String?
  createdAt     DateTime       @default(now())
  passkeys      Passkey[]
  agent         Agent?
  cpcvDocuments CpcvDocument[] // signed CPCV PDFs this admin uploaded
}

model EmailCode {
  id         String    @id @default(cuid())
  email      String // normalized: trimmed, lowercase
  codeHash   String // HMAC-SHA256(SESSION_SECRET, email + code), hex; never the code itself
  expiresAt  DateTime
  consumedAt DateTime? // set on successful verify, or when a newer code supersedes this one
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) // resend cooldown and hourly cap per email

  @@index([email])
}

model Passkey {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  credentialId  String   @unique // base64url
  publicKeyCose Bytes
  publicKeyP256 Bytes // 65-byte uncompressed secp256r1 key, for the smart account
  counter       Int
  transports    String[]
  createdAt     DateTime @default(now())
}

model Agent {
  userId             String              @id
  user               User                @relation(fields: [userId], references: [id])
  smartAccount       String              @unique // C... address
  agentField         String // hex, spec §8.4
  lithicCardToken    String?             @unique
  cardLast4          String?
  cardEnabledOnChain Boolean             @default(false)
  signerKind         String              @default("passkey") // "passkey" | "demo-ed25519" (seed agents)
  cachedPosition     Json? // last AgentPosition read, for the ASA fallback
  cachedAt           DateTime?
  cpcvs              Cpcv[]
  authorizations     CardAuthorization[]
}

model Cpcv {
  id                   String        @id @default(cuid())
  agentId              String
  agent                Agent         @relation(fields: [agentId], references: [userId])
  piiEncrypted         Bytes // AES-256-GCM JSON: buyer/seller names + NIFs, property address, sale price, rate, cpcv date
  totalCommissionCents BigInt
  agentCommissionCents BigInt
  escrituraDay         Int
  commitment           String // hex
  nullifier            String // hex
  proof                Json? // snarkjs proof + publicSignals
  status               CpcvStatus    @default(DRAFT)
  noteId               Int?          @unique
  mintTxHash           String?
  settleTxHash         String?
  cancelTxHash         String?
  error                String?
  createdAt            DateTime      @default(now())
  document             CpcvDocument? // the signed CPCV PDF, when the admin uploaded one
}

// The signed CPCV PDF an admin uploads on New CPCV (personal data: never
// on-chain, never in the public APIs). Content and Claude's extraction are
// AES-256-GCM encrypted with PII_ENCRYPTION_KEY, like Cpcv.piiEncrypted.
// Uploaded before the CPCV exists; the pipeline links it (cpcvId) when the
// admin submits. Unlinked uploads are deleted after 24 h.
model CpcvDocument {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())
  uploadedById        String
  uploadedBy          User     @relation(fields: [uploadedById], references: [id])
  fileName            String // sanitized original name, for Content-Disposition
  sizeBytes           Int
  sha256              String // hex, of the plaintext PDF
  contentEncrypted    Bytes // AES-256-GCM: iv ‖ tag ‖ ciphertext of the PDF bytes
  extractionEncrypted Bytes? // AES-256-GCM JSON: CpcvExtraction (lib/types/api.ts), when Claude read it
  extractionError     String? // error code when the AI prefill didn't run or failed (no personal data)
  cpcvId              String?  @unique
  cpcv                Cpcv?    @relation(fields: [cpcvId], references: [id], onDelete: Cascade)
}

model CardAuthorization {
  id                 String       @id @default(cuid())
  lithicToken        String       @unique // Lithic transaction token (idempotency)
  agentId            String
  agent              Agent        @relation(fields: [agentId], references: [userId])
  amountCents        BigInt
  merchant           String
  decision           AuthDecision
  declineReason      String?
  chainStatus        ChainStatus  @default(PENDING)
  fromBalanceStroops BigInt?
  fromCreditStroops  BigInt?
  txHash             String?
  attempts           Int          @default(0)
  createdAt          DateTime     @default(now())

  @@index([agentId, createdAt])
}

model ChainEvent {
  id         String   @id @default(cuid())
  contract   String
  type       String
  ledger     Int
  txHash     String
  eventIdx   Int
  data       Json
  protocolTs BigInt?
  createdAt  DateTime @default(now())

  @@unique([txHash, eventIdx])
  @@index([type, ledger])
}

model PoolSnapshot {
  id           String   @id @default(cuid())
  protocolTs   BigInt
  seniorAssets BigInt
  juniorAssets BigInt
  feesAccrued  BigInt
  totalDebt    BigInt
  poolCash     BigInt
  sharePrice   String // scaled decimal string
  shareSupply  BigInt
  createdAt    DateTime @default(now())

  @@index([protocolTs])
}

model Deployment {
  id          String   @id @default(cuid())
  network     String
  active      Boolean  @default(true)
  teurc       String
  cpcvNote    String
  advancePool String
  wasmHashes  Json
  createdAt   DateTime @default(now())
}

model IndexerCursor {
  id         String @id
  lastLedger Int
}
