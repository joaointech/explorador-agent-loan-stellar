# Copy to apps/web/.env.local (`pnpm keys:generate` writes most of these for you).

DATABASE_URL=postgresql://advance:advance@localhost:5433/advance
APP_URL=http://localhost:3000
SESSION_SECRET=                 # ≥ 32 random chars
ADMIN_EMAILS=you@explorador.ai  # comma-separated; these emails get the ADMIN role
RESEND_API_KEY=                 # optional in dev: codes are logged to the server console
EMAIL_FROM="explorador advance <advance@explorador.ai>"
WEBAUTHN_RP_ID=localhost        # advance.explorador.ai in production
WEBAUTHN_RP_NAME="explorador advance"

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ADMIN_SECRET=
OPERATOR_SECRET=
TREASURY_SECRET=
CARD_SETTLEMENT_PUBLIC=
SPONSOR_SECRET=
DEMO_MODE=true

ATTESTER_EDDSA_PRIVKEY=         # BabyJubJub private key (hex), off-chain only
NULLIFIER_SECRET=               # BN254 field element (decimal)
PII_ENCRYPTION_KEY=             # 32 bytes, hex (AES-256-GCM)

LITHIC_API_KEY=                 # sandbox key; unset → in-app simulated card network
LITHIC_ASA_HMAC_SECRET=         # filled by `pnpm lithic:enroll`
