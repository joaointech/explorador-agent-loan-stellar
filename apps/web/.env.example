# Copy to .env.local, or run `pnpm keys:generate` (writes .env.local with fresh testnet keys).
# TESTNET ONLY — never reuse these keys anywhere else.
DATABASE_URL=postgresql://advance:advance@localhost:5433/advance
APP_URL=http://localhost:3000
SESSION_SECRET=
CRON_SECRET=
ADMIN_EMAILS=you@explorador.pt
RESEND_API_KEY=            # optional in dev (codes are logged to the server console)
EMAIL_FROM="explorador advance <advance@explorador.pt>"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="explorador advance"

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ADMIN_SECRET=
OPERATOR_SECRET=
TREASURY_SECRET=
CARD_SETTLEMENT_PUBLIC=
SPONSOR_SECRET=
DEMO_MODE=true

ATTESTER_EDDSA_PRIVKEY=
NULLIFIER_SECRET=
PII_ENCRYPTION_KEY=

LITHIC_API_KEY=            # sandbox key; without it the agent page simulates purchases locally
LITHIC_ASA_HMAC_SECRET=    # filled by `pnpm lithic:enroll`

# Optional overrides (defaults are the OpenZeppelin smart-account contracts already on testnet)
# SMART_ACCOUNT_WASM_HASH=
# WEBAUTHN_VERIFIER_ADDRESS=
# ED25519_VERIFIER_ADDRESS=
# NATIVE_TOKEN_CONTRACT=
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
